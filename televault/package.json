{
  "name": "televault",
  "version": "0.1.0-rc.1",
  "description": "Your Telegram account as a real cloud drive",
  "author": {
    "name": "TeleVault",
    "email": "support@televault.app"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hsay123/TGDrive.git"
  },
  "homepage": "https://github.com/hsay123/TGDrive",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json -w --preserveWatchOutput\" \"wait-on http://localhost:5173 dist-electron/electron/main.js && env -u ELECTRON_RUN_AS_NODE electron .\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "clean": "node -e \"const fs=require('fs');for(const d of ['dist','dist-electron'])fs.rmSync(d,{recursive:true,force:true})\"",
    "build:prepare": "npm run clean && npm run icons && npm run build:electron && vite build",
    "build": "npm run build:prepare && electron-builder",
    "build:win": "npm run build:prepare && electron-builder --win",
    "build:mac": "npm run build:prepare && electron-builder --mac --x64 --arm64",
    "build:linux": "npm run build:prepare && electron-builder --linux",
    "build:dir": "npm run build:prepare && electron-builder --dir",
    "icons": "node scripts/generate-icons.mjs",
    "preview": "vite preview",
    "rebuild": "electron-rebuild -f -w better-sqlite3,keytar",
    "postinstall": "electron-rebuild -f -w better-sqlite3,keytar",
    "test": "node scripts/run-tests.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "checksums": "node scripts/generate-checksums.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.2.0",
    "better-sqlite3": "^13.2.0",
    "clsx": "^2.1.0",
    "dotenv": "^16.4.5",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.1.7",
    "keytar": "^7.9.0",
    "lucide-react": "^0.383.0",
    "mime-types": "^2.1.35",
    "motion": "^12.42.2",
    "prismjs": "^1.30.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.22.3",
    "sharp": "^0.35.0",
    "telegram": "^2.26.0",
    "uuid": "^9.0.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/better-sqlite3": "^7.6.8",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.11.30",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.49.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.6",
    "vitest": "^1.6.1",
    "wait-on": "^7.2.0"
  }
}
